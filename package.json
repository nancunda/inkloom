{
  "name": "inkloom",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tsc": "tsc --build tsconfig.base.json",
    "test": "vitest run --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "test:int": "vitest run --project integration",
    "biome": "biome check .",
    "biome:fix": "biome check --write .",
    "check-deps": "node scripts/check-deps.mjs",
    "cli": "tsx --env-file-if-exists=.env apps/cli/src/index.ts",
    "api": "tsx --env-file-if-exists=.env apps/api/src/server.ts",
    "web": "pnpm --filter @inkloom/web dev",
    "fixture": "tsx scripts/build-fixture.ts",
    "verify:p0": "tsx scripts/verify-p0.ts",
    "verify:p1a": "tsx scripts/verify-p1a.ts",
    "verify:p1b": "tsx scripts/verify-p1b.ts",
    "verify:p1c": "tsx scripts/verify-p1c.ts",
    "verify:p2a": "tsx scripts/verify-p2a.ts",
    "verify:p2c": "tsx scripts/verify-p2c.ts",
    "verify": "pnpm biome && pnpm tsc && pnpm check-deps && pnpm test && pnpm test:int"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
