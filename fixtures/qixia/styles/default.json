{
  "id": "style_default",
  "projectId": "proj_f81c8babe4d642c2",
  "name": "冷硬短句",
  "description": "短句为主，少形容词；用动作与物象承载情绪，不写“他感到/她心里”这类心理陈述",
  "samples": [
    "风从袖口灌进来。她按住玉牌，指节泛白。",
    "剑气贴着面颊削过去。她没躲。"
  ],
  "bannedWords": [
    "仿佛",
    "不禁",
    "顿时",
    "宛如",
    "似乎"
  ],
  "bannedPatterns": [
    "不是……而是……",
    "空气中弥漫着"
  ],
  "quantLimits": {
    "仿佛": 0,
    "似乎": 0,
    "心中": 2
  },
  "isDefault": true
}
